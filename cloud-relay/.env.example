PORT=3000
# Optional public base URL used in job_dispatch download_url (auto-detected from request Host if omitted)
PUBLIC_URL=

# Razorpay credentials (leave blank to run in Dev/Test fallback mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=dev_webhook_secret

# Default kiosk pricing in paise (100 paise = ₹1.00)
DEFAULT_BW_PRICE_PAISE=200
DEFAULT_COLOR_PRICE_PAISE=1000

# Temporary file storage & TTL (ms)
UPLOAD_DIR=./uploads
FILE_TTL_MS=3600000
