{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JetPrint",
  "version": "0.1.0",
  "identifier": "com.jetprint.kiosk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "JetPrint Kiosk",
        "width": 1280,
        "height": 800,
        "fullscreen": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3NjA0OThEMzA1QUU2RDcKUldUWDVsb3dqVWxnWjg5bmhtVlhGL25HajZjWFFHNHhsSnRzTk04VkdoYWoySWpnbE1hQW16M3YK",
      "endpoints": [
        "https://github.com/dharantej1/JetPrint/releases/latest/download/updater.json"
      ]
    }
  }
}

